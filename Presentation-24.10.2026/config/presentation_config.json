{
  "project_name": "presentation_24_10_2026_topic_5",
  "topic_title": "Đánh giá mô hình dự báo đúng cách: Data Leakage và Backtesting",
  "dataset": {
    "recommended_dataset": "AirPassengers or Electricity/Energy/StoreSales",
    "timestamp_col": "date",
    "target_col": "value",
    "frequency": "MS"
  },
  "split": {
    "test_ratio": 0.2,
    "random_seed": 42
  },
  "scaling_experiment": {
    "methods": ["standard", "minmax"]
  },
  "baseline": {
    "naive_enabled": true,
    "seasonal_naive_enabled": true,
    "season_length": 12
  },
  "forecasting_model": {
    "model_type": "RidgeRegression_LagFeatures",
    "max_lags": 12
  },
  "backtesting": {
    "expanding_window": {
      "initial_train_size": 72,
      "horizon": 12,
      "step_size": 6
    },
    "rolling_window": {
      "window_size": 72,
      "horizon": 12,
      "step_size": 6
    }
  },
  "horizon_evaluation": {
    "max_horizon": 12
  },
  "metrics": ["MAE", "RMSE", "MAPE"]
}
