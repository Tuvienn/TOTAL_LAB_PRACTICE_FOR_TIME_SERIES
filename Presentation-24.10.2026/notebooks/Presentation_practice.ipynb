    "# 4. Trực quan hóa Visual 2\n",
    "temp_train_idx = list(range(len(train_temp)))\n",
    "temp_test_idx = list(range(len(train_temp), len(full_data)))\n",
    "rand_train_idx = [full_data.index.get_loc(idx) for idx in train_rand.index]\n",
    "rand_test_idx = [full_data.index.get_loc(idx) for idx in test_rand.index]\n",
    "\n",
    "visual_2_path = FIGURES_DIR / \"02_random_vs_temporal_split.png\"\n",
    "plot_split_comparison(full_data, rand_train_idx, rand_test_idx, temp_train_idx, temp_test_idx, save_path=str(visual_2_path))\n",
