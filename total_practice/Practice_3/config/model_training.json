{
  "phase": "phase_05_model_training_selection",
  "forecast_protocol": {
    "mode": "one_step",
    "target": "AEP_MW",
    "frequency": "h",
    "final_test_state": "SEALED"
  },
  "metrics": {
    "primary": "mae",
    "secondary": "rmse",
    "standard_deviation_ddof": 0,
    "cv_summary": [
      "mean",
      "standard_deviation"
    ]
  },
  "baselines": {
    "seasonal_naive_24": {
      "lag": 24
    },
    "persistence": {
      "lag": 1
    }
  },
  "screening": {
    "configuration_order": [
      "lag_only_p24",
      "lag_only_p72",
      "lag_only_p168",
      "lag_rolling_p24",
      "lag_rolling_p72",
      "lag_rolling_p168"
    ],
    "model": "xgboost_baseline",
    "parameters": {
      "objective": "reg:squarederror",
      "n_estimators": 300,
      "max_depth": 6,
      "learning_rate": 0.05,
      "subsample": 1.0,
      "colsample_bytree": 1.0,
      "min_child_weight": 1,
      "reg_alpha": 0.0,
      "reg_lambda": 1.0,
      "tree_method": "hist",
      "random_state": 42,
      "n_jobs": -1
    },
    "selection": {
      "relative_mae_tolerance": 0.01,
      "decision_order": [
        "mean_mae_relative_tolerance_pool",
        "fewer_features",
        "mean_rmse",
        "mae_standard_deviation",
        "approved_configuration_order"
      ]
    }
  },
  "tuning": {
    "search_method": "RandomizedSearchCV",
    "n_iter": 24,
    "scoring": {
      "mae": "neg_mean_absolute_error",
      "rmse": "neg_root_mean_squared_error"
    },
    "refit": "mae",
    "random_state": 42,
    "early_stopping": false,
    "search_space": {
      "n_estimators": [
        300,
        500,
        800
      ],
      "max_depth": [
        3,
        5,
        7
      ],
      "learning_rate": [
        0.03,
        0.05,
        0.1
      ],
      "subsample": [
        0.7,
        0.85,
        1.0
      ],
      "colsample_bytree": [
        0.7,
        0.85,
        1.0
      ],
      "min_child_weight": [
        1,
        5,
        10
      ],
      "reg_alpha": [
        0.0,
        0.1,
        1.0
      ],
      "reg_lambda": [
        1.0,
        5.0,
        10.0
      ]
    }
  },
  "random_forest": {
    "parameters": {
      "n_estimators": 300,
      "max_depth": null,
      "min_samples_split": 2,
      "min_samples_leaf": 1,
      "max_features": 1.0,
      "bootstrap": true,
      "random_state": 42,
      "n_jobs": -1
    }
  },
  "model_lock": {
    "candidate_order": [
      "seasonal_naive_24",
      "persistence",
      "xgboost_baseline",
      "xgboost_tuned",
      "random_forest"
    ],
    "simplicity_order": [
      "seasonal_naive_24",
      "persistence",
      "xgboost_baseline",
      "random_forest",
      "xgboost_tuned"
    ],
    "relative_mae_tolerance": 0.01
  },
  "policies": {
    "train_cv_only": true,
    "final_test_sealed": true,
    "materialize_final_test_in_training": false,
    "persist_binary_models": false
  }
}
